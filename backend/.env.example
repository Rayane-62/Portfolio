# ── Serveur ─────────────────────────────────────────────
PORT=4300
NODE_ENV=development

# Adresses des deux sites autorisés à appeler l'API (séparées par des virgules)
CORS_ORIGINS=http://localhost:3300,http://localhost:5200

# Adresse publique de l'API (sert à construire l'URL de la photo, des images et du CV)
PUBLIC_API_URL=http://localhost:4300

# Dossier des fichiers envoyés (par défaut : backend/uploads). Pense à le sauvegarder sur le VPS.
# UPLOADS_DIR=/var/www/portfolio/uploads

# ── Base de données ─────────────────────────────────────
# PostgreSQL installé sur le PC : remplace TON_MOT_DE_PASSE et le port (5432 par défaut).
# La base « portfolio » est créée automatiquement par npm run db:migrate.
DATABASE_URL=postgres://postgres:TON_MOT_DE_PASSE@localhost:5432/portfolio

# ── Sécurité ────────────────────────────────────────────
# Mets une longue chaîne aléatoire (ex. : openssl rand -hex 32)
JWT_SECRET=change-moi-par-une-longue-chaine-aleatoire
JWT_EXPIRES_IN=7d

# ── Premier lancement (npm run db:seed) ─────────────────
SEED_ADMIN_FIRSTNAME=Admin
SEED_ADMIN_LOGIN=admin
SEED_ADMIN_PASSWORD=ChangeMoi123

# ── Reprise des données Strapi (npm run db:import) ──────
# Fichier exporté de Strapi. Par défaut : ../pf-data/content.json
# CONTENT_FILE=../pf-data/content.json
